# Скопируйте в .env и измените под сервер. Значения ниже — для локальной разработки.

# --- База данных ---
# Пароль подставляется в DATABASE_URL — используйте URL-безопасные символы.
# Смена пароля на существующем томе не меняет пароль в БД: нужен либо новый том,
# либо ALTER USER внутри контейнера.
POSTGRES_USER=mda
POSTGRES_PASSWORD=mda
POSTGRES_DB=mda

# --- Порты и время ---
# Наружу публикуется только фронтенд. Порт БД слушает только loopback.
# FRONTEND_BIND=127.0.0.1 — если перед фронтом стоит reverse-proxy с TLS.
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8080
DB_PORT=5432
TZ=Europe/Moscow
TIMEZONE=Europe/Moscow

# --- Сессия ---
SESSION_TTL_DAYS=7
# true — обязательно при работе через HTTPS (иначе cookie уйдёт по HTTP).
SESSION_COOKIE_SECURE=false

# --- Схема API ---
# false — закрыть /docs, /redoc и /openapi.json.
DOCS_ENABLED=true

# --- Первый оператор ---
# Создаётся при первом старте, только если заданы ОБА значения (пароль ≥ 8 символов).
# Если оставить пустыми — создайте оператора вручную:
#   docker compose exec api python -m app.create_operator --login <логин>
SEED_OPERATOR_LOGIN=
SEED_OPERATOR_PASSWORD=

# --- LDAP (необязательно) ---
# false — вход только локальными паролями, поведение как раньше.
LDAP_ENABLED=false
LDAP_HOST=dc.example.org:389
LDAP_VERSION=3
LDAP_BASE_DN=ou=people,dc=example,dc=org
LDAP_BIND_DN=cn=svc,ou=service,dc=example,dc=org
LDAP_BIND_PASSWORD=
# none | starttls | ldaps. none допустим только во внутренней сети.
LDAP_TLS=none
LDAP_TLS_VERIFY=true
# LDAP_TLS_CA_CERT=/etc/ssl/certs/internal-ca.pem
LDAP_LOGIN_FILTER=(|(uid={login})(sAMAccountName={login}))
# Атрибут логина: в AD — sAMAccountName, в OpenLDAP/FreeIPA — uid.
LDAP_LOGIN_ATTR=uid
# ФИО: в AD — displayName. ID: в AD — objectGUID, в OpenLDAP — entryUUID.
LDAP_NAME_ATTR=cn
LDAP_ID_ATTR=entryUUID
# LDAP_USER_FILTER=(memberOf=cn=trapeznaya,ou=groups,dc=example,dc=org)
# Кто попадёт в Postgres. Пусто → берётся LDAP_USER_FILTER;
# оба пусты → ночной синк откажется работать.
LDAP_SYNC_FILTER=
LDAP_TIMEOUT=5
LDAP_SYNC_ENABLED=false
LDAP_SYNC_HOUR=23
